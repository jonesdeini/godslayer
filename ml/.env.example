# Same broker as the Rails app - see the root .env.example.
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# The Rails app's own read API - defaults to a local `rails server`.
GODSLAYER_API_URL=http://localhost:3000

# A local Ollama instance (not a hosted API - see CLAUDE.md on why).
OLLAMA_URL=http://localhost:11434
