# Copy to .env and fill in. .env is gitignored.

# --- Rails (required by the deployed container to sign/encrypt cookies and
# CSRF tokens - generate with `bin/rails secret`) ---
SECRET_KEY_BASE=

# --- eBay Developer Program (Browse API, client_credentials) ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
# sandbox or production - must match which keyset above you're using.
EBAY_ENVIRONMENT=sandbox

# 0 = no price cap.
PRICE_CAP_CENTS=0

# 2-letter country code to restrict results to (e.g. US) - blank = no filter.
ITEM_LOCATION_COUNTRY=

# --- RabbitMQ (work queue for the future Python photo-sorter/extraction
# workers) - defaults to a local broker, override for docker-compose/prod. ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- RabbitMQ credentials, docker-compose only ---
RABBITMQ_USER=godslayer
RABBITMQ_PASSWORD=

SENTRY_DSN=
SENTRY_DSN_ML=

# --- LLM provider for the one-off `rails listings:label` task only - not
# used by the running app/jobs, so leave blank unless you're running that
# task. LLM_PROVIDER picks which client Llm::Client dispatches to (defaults
# to anthropic; only anthropic is implemented so far). ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- docker-compose only - the deploy box's own Tailscale IP
TAILSCALE_IP=
