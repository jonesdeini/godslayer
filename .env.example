# Copy to .env and fill in. .env is gitignored.

# --- Rails (required by the deployed container to sign/encrypt cookies and
# CSRF tokens - generate with `bin/rails secret`) ---
SECRET_KEY_BASE=

# --- eBay Developer Program (Browse API, client_credentials) ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
# sandbox or production - must match which keyset above you're using.
EBAY_ENVIRONMENT=sandbox

# 0 = no price cap.
PRICE_CAP_CENTS=0

# --- RabbitMQ (work queue for the future Python photo-sorter/extraction
# workers) - defaults to a local broker, override for docker-compose/prod. ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- RabbitMQ credentials, docker-compose only ---
RABBITMQ_USER=godslayer
RABBITMQ_PASSWORD=
