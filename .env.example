# Copy to .env and fill in. .env is gitignored.

# --- Rails (required by the deployed container - no config/master.key baked
# into the image, it's git/dockerignored on purpose) ---
RAILS_MASTER_KEY=

# --- eBay Developer Program (Browse API, client_credentials) ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
